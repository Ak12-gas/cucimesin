{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?__route=uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=:path*"
    }
  ],
  "functions": {
    "api/**": {
      "includeFiles": "{db/schema-supabase.sql,templates/**,node_modules/@sparticuz/chromium/bin/**}",
      "excludeFiles": "public/**",
      "maxDuration": 60
    }
  }
}
