# CuciMesin .env.example
# Salin ke .env untuk pengembangan lokal. Jangan commit .env atau nilai rahasia.
# Klasifikasi: Wajib | Opsional | Wajib produksi | Khusus migrasi | Khusus platform.

# Runtime / platform
PORT=3000                       # Opsional. Lokal/dev saja; platform deployment menyediakan PORT.
NODE_ENV=development            # Opsional. Gunakan "production" di deployment; Dockerfile sudah menyetelnya.
# APP_ENV=staging               # Opsional. Set eksplisit ke "staging" untuk validasi fail-closed staging; jangan set di production/dev biasa.
APP_TIME_ZONE=Asia/Jakarta      # Opsional (default Asia/Jakarta). Gunakan nama IANA valid/UTC.

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DATABASE_URL=        # Opsional. Alias fallback untuk DATABASE_URL pada mode non-staging; jangan isi keduanya kecuali perlu.
# APP_ENV=staging: DATABASE_URL wajib eksplisit dan SUPABASE_DATABASE_URL TIDAK menjadi fallback.
DB_CONNECTION_LIMIT=5           # Opsional. Default 5; Vercel/serverless direkomendasikan 1.

# Auth & keamanan
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak  # Wajib produksi & staging. App gagal start jika kosong pada mode tersebut.
# JWT_EXPIRES=7d                # Opsional. Masa berlaku token JWT, default 7d.
CORS_ORIGINS=http://localhost:3000               # Opsional untuk same-origin; wajib saat frontend beda origin. CSV origin.
# TRUST_PROXY=loopback          # Opsional. Gunakan hop count/IP proxy tepercaya. Nilai "true" TIDAK diperbolehkan.
# Vercel: TRUST_PROXY=1

# Upload / storage lokal fallback
UPLOAD_DIR=uploads              # Opsional. Lokal/Docker volume; Vercel serverless meremap ke /tmp.
PAYMENT_UPLOAD_DIR=data/payment-proofs  # Opsional/legacy fallback bukti lama.

# Supabase Storage (wajib untuk penyimpanan file persisten di Vercel; direkomendasikan produksi)
# Kedua bucket bersifat private. Foto SPK lewat backend proxy; signed URL hanya fallback foto SPK TTL 60 detik (on-demand, tidak dipersist).
# Bukti pembayaran tidak menggunakan signed URL dan hanya lewat backend berautorisasi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Saat APP_ENV=staging, bucket per-asset WAJIB ditentukan eksplisit:
SUPABASE_STORAGE_BUCKET_SPK=
SUPABASE_STORAGE_BUCKET_PAYMENT_PROOFS=
# Legacy/compat (opsional, bukan pengganti bucket per-asset):
# SUPABASE_STORAGE_BUCKET=cucimesin

# Rate limit bersama (direkomendasikan untuk serverless/multi-instance produksi)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reset password (wajib fungsional di produksi)
# Webhook menerima POST JSON: { identifier, token, expires_at }
# Tanpa RESET_WEBHOOK_URL di production, token reset tidak dikirim ke user dan dev_token tidak dikembalikan.
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=

# PDF/Chromium (khusus platform/container bila perlu)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium  # Opsional. Lokal/Docker; Dockerfile sudah menyetelnya.
# PUPPETEER_SKIP_DOWNLOAD=true                  # Opsional saat build image/container.

# Khusus migrasi MySQL -> Supabase (jangan isi di Vercel/production runtime)
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=cucimesin
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=
# Alias sumber migrasi lama yang juga didukung skrip:
# DB_HOST= DB_PORT= DB_NAME= DB_USER= DB_PASSWORD=