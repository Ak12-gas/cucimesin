PORT=3000
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_CONNECTION_LIMIT=5
APP_TIME_ZONE=Asia/Jakarta
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
PAYMENT_UPLOAD_DIR=data/payment-proofs

# Supabase Storage (opsional untuk lokal, wajib untuk produksi/Vercel).
# Bucket foto SPK sebaiknya public agar <img> di frontend langsung bisa memuatnya.
# Bukti pembayaran tetap disajikan lewat /api/pembayaran/:id/bukti dengan service role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cucimesin

# Rate limit bersama (opsional, direkomendasikan di serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pengiriman kode reset password. Webhook menerima { identifier, token, expires_at }.
# Tanpa ini, token hanya dikembalikan sebagai dev_token saat NODE_ENV != production.
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=

# Koneksi MySQL sumber, hanya diperlukan saat menjalankan npm run migrate:supabase.
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=cucimesin
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=
# Set only when running behind a trusted reverse proxy, e.g. loopback for local Nginx.
# TRUST_PROXY=loopback