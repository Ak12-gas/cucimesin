PORT=3000
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_CONNECTION_LIMIT=5
JWT_SECRET=ganti-dengan-secret-panjang-dan-acak
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
PAYMENT_UPLOAD_DIR=data/payment-proofs
# Koneksi MySQL sumber, hanya diperlukan saat menjalankan npm run migrate:supabase.
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=cucimesin
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=
# Set only when running behind a trusted reverse proxy, e.g. loopback for local Nginx.
# TRUST_PROXY=loopback